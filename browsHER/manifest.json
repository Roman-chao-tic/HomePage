{
  "manifest_version": 3,
  "name": "browsHER",
  "version": "2.0",
  "description": "Your personal glassy homepage — emotions, facts, day/night vibes.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://numbersapi.com/*",
    "https://en.wikipedia.org/*"
  ],
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_title": "browsHER"
  }
}
